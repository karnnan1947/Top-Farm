<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Broiler batches are numbered BR-BATCH-2026-001 when their chicks are placed in a broiler shed
             (layer flocks keep their [Estate Code]-[Date] names) -->
        <record id="seq_farm_broiler_batch" model="ir.sequence">
            <field name="name">Broiler Flock Batch Sequence</field>
            <field name="code">farm.broiler.batch</field>
            <field name="prefix">BR-BATCH-%(year)s-</field>
            <field name="padding">3</field>
            <!-- a placement that fails to validate must not burn a batch number -->
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
