<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit standard stock.location form view -->
    <record id="view_location_form_top_farm" model="ir.ui.view">
        <field name="name">stock.location.form.top_farm</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header groups="top_farm_core.group_farm_manager" invisible="farm_hierarchy_level != 'brooding'">
                    <button name="action_allocate_birds"
                            string="Allocate Flock to Cages"
                            type="object"
                            class="oe_highlight"
                            invisible="not flock_lot_ids"/>
                </header>
            </xpath>

            <!-- Smart buttons in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cages"
                        type="object"
                        class="oe_stat_button"
                        icon="grid_view"
                        invisible="farm_hierarchy_level not in ('farm', 'shed')"
                        groups="top_farm_core.group_farm_user">
                    <field name="sub_cage_count" widget="statinfo" string="Cages"/>
                </button>
                <button name="action_view_live_birds"
                        type="object"
                        class="oe_stat_button"
                        icon="favorite"
                        invisible="not farm_hierarchy_level"
                        groups="top_farm_core.group_farm_user">
                    <field name="live_bird_count" widget="statinfo" string="Live Birds"/>
                </button>
                <button name="action_view_flocks"
                        type="object"
                        class="oe_stat_button"
                        icon="stacks"
                        invisible="not flock_lot_ids"
                        groups="top_farm_core.group_farm_user"
                        string="Flocks"/>
            </xpath>

            <!-- Poultry Farm Infrastructure & Analytics Group -->
            <xpath expr="//div[hasclass('oe_location_header')]" position="after">
                <group name="top_farm_group" string="Poultry Farm Infrastructure"
                       groups="top_farm_core.group_farm_user">
                    <group>
                        <field name="farm_hierarchy_level"/>
                        <field name="farm_code" invisible="farm_hierarchy_level != 'farm'"
                               required="farm_hierarchy_level == 'farm'" placeholder="e.g. IHL"/>
                        <field name="parent_farm_location_id"
                               invisible="farm_hierarchy_level not in ('brooding', 'shed', 'cage')"/>
                        <field name="farm_analytic_account_id"
                               invisible="farm_hierarchy_level != 'cage'"/>
                    </group>
                    <group invisible="farm_hierarchy_level not in ('brooding', 'cage')">
                        <field name="flock_lot_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Dedicated List View for Farm Locations (Odoo 20 <list>) -->
    <record id="view_location_tree_top_farm" model="ir.ui.view">
        <field name="name">stock.location.list.top_farm</field>
        <field name="model">stock.location</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Poultry Farm Infrastructure">
                <field name="complete_name" string="Location Name"/>
                <field name="farm_hierarchy_level" widget="badge"
                       decoration-info="farm_hierarchy_level == 'farm'"
                       decoration-warning="farm_hierarchy_level == 'brooding'"
                       decoration-muted="farm_hierarchy_level == 'shed'"
                       decoration-success="farm_hierarchy_level == 'cage'"/>
                <field name="farm_code" optional="show"/>
                <field name="parent_farm_location_id" optional="show"/>
                <field name="flock_lot_ids" widget="many2many_tags"/>
                <!-- No sum: a farm's count already includes its nurseries and cages -->
                <field name="live_bird_count"/>
                <field name="farm_analytic_account_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View Filters -->
    <record id="view_location_search_top_farm" model="ir.ui.view">
        <field name="name">stock.location.search.top_farm</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="parent_farm_location_id"/>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Farms" name="filter_farm" domain="[('farm_hierarchy_level', '=', 'farm')]"/>
                <filter string="Brooding Nurseries" name="filter_brooding" domain="[('farm_hierarchy_level', '=', 'brooding')]"/>
                <filter string="Laying Sheds" name="filter_shed" domain="[('farm_hierarchy_level', '=', 'shed')]"/>
                <filter string="Cages" name="filter_cage" domain="[('farm_hierarchy_level', '=', 'cage')]"/>
            </xpath>
            <!-- Odoo 20 search <group> takes no expand/string attributes: reuse core's Group By block -->
            <xpath expr="//search/group" position="inside">
                <filter string="Hierarchy Level" name="group_level" context="{'group_by': 'farm_hierarchy_level'}"/>
                <filter string="Farm" name="group_farm" context="{'group_by': 'parent_farm_location_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_top_farm_locations" model="ir.actions.act_window">
        <field name="name">Farm Infrastructure</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_location_tree_top_farm"/>
        <field name="domain">[('farm_hierarchy_level', '!=', False)]</field>
        <field name="context">{'search_default_group_farm': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first farm facility
            </p>
            <p>
                Build the permanent infrastructure of each estate: the Farm Facility (with its estate code),
                its Brooding Nurseries, and its Laying Sheds and Cages. Flocks are lots that move through them.
            </p>
        </field>
    </record>
</odoo>
