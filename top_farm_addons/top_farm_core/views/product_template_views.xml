<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_top_farm" model="ir.ui.view">
        <field name="name">product.template.form.top_farm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span name="farm_bird_option" class="d-inline-flex">
                    <field name="is_farm_bird"/>
                    <label for="is_farm_bird"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
