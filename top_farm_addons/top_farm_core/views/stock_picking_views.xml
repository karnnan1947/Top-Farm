<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approach A: the clerk enters the flock lot of chicks dispatched to a brooding nursery.
         Consumption transfers (feed, medication, scrap): the flock (and its house) the cost is charged to. -->
    <record id="view_picking_form_top_farm" model="ir.ui.view">
        <field name="name">stock.picking.form.top_farm</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']" position="before">
                <field name="farm_to_brooding" invisible="1"/>
                <field name="farm_show_flock_lot" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='lot_ids']" position="after">
                <field name="farm_flock_lot_id" string="Flock Lot"
                       column_invisible="not parent.farm_show_flock_lot"
                       readonly="state in ('done', 'cancel')"
                       domain="[('is_flock_batch', '=', True)] + ([('product_id', '=', product_id)] if parent.farm_to_brooding else [('flock_stage', '!=', 'spent')])"
                       context="{'default_product_id': product_id, 'default_is_flock_batch': True}"
                       placeholder="e.g. IHL-19-10-2026"/>
                <field name="farm_location_id" string="Farm House" optional="show"
                       column_invisible="not parent.farm_show_flock_lot or parent.farm_to_brooding"
                       readonly="state in ('done', 'cancel')"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
