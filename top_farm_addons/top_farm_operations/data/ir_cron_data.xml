<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Expenses laying feed of past days that no egg collection consumed. Runs after midnight
             (server time, UTC) so each day's collections can be entered until the day is over. -->
        <record id="cron_reconcile_unharvested_feed" model="ir.cron">
            <field name="name">Top Farm: Reconcile Unharvested Laying Feed</field>
            <field name="model_id" ref="model_farm_feed_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_unharvested_feed()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:30:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Checks the rolling hen-day rate of the rearing flocks on the complete days up to yesterday:
             alerts the Farm Managers, or starts the Laying Phase in automatic mode. -->
        <record id="cron_check_laying_transition" model="ir.cron">
            <field name="name">Top Farm: Flock Laying Transition Check (Hen-Day Benchmark)</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_laying_transition()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:45:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
