<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_top_farm_operations" model="ir.ui.view">
        <field name="name">stock.lot.form.top_farm.operations</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="top_farm_core.view_production_lot_form_top_farm"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_close_broiler_batch']" position="before">
                <!-- Broiler batch: harvest in Growing and Harvesting only (never in Brooding) -->
                <button name="action_open_broiler_harvest_wizard" string="Harvest Broilers" type="object"
                        class="oe_highlight"
                        invisible="flock_type != 'broiler' or flock_stage not in ('growing', 'harvesting') or not live_bird_count"
                        groups="top_farm_core.group_farm_manager"/>
                <!-- Layer flock: cull all or part of the hens into Layer Live Weight (kg) -->
                <button name="action_open_broiler_harvest_wizard" string="Cull / Harvest Hens" type="object"
                        invisible="flock_type != 'layer' or flock_stage not in ('laying', 'spent') or not live_bird_count"
                        groups="top_farm_core.group_farm_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_feed_logs" type="object" class="oe_stat_button" icon="restaurant"
                        string="Feed Logs" invisible="not is_flock_batch" groups="top_farm_core.group_farm_user"/>
                <button name="action_view_broiler_harvests" type="object" class="oe_stat_button" icon="scale"
                        invisible="not broiler_harvest_count" groups="top_farm_core.group_farm_manager">
                    <field name="broiler_harvest_count" widget="statinfo" string="Meat Harvests"/>
                </button>
                <button name="action_view_egg_collections" type="object" class="oe_stat_button" icon="shopping_basket"
                        string="Egg Collections"
                        invisible="flock_stage not in ('rearing', 'laying', 'spent') or flock_type == 'broiler'"
                        groups="top_farm_core.group_farm_user"/>
            </xpath>
            <xpath expr="//field[@name='flock_location_ids']" position="after">
                <field name="rolling_hen_day_pct" invisible="flock_stage not in ('rearing', 'laying')"/>
                <field name="laying_notification_sent" invisible="flock_stage != 'rearing' or not laying_notification_sent"/>
            </xpath>
            <!-- Broiler batch: harvests, feed conversion and margin -->
            <xpath expr="//group[@name='broiler_group']" position="after">
                <group name="broiler_harvest_group" string="Broiler Batch - Harvests &amp; Performance"
                       invisible="not is_flock_batch or flock_type != 'broiler' or not broiler_feed_qty and not broiler_harvest_count"
                       groups="top_farm_core.group_farm_user">
                    <group>
                        <field name="broiler_harvested_birds"/>
                        <field name="broiler_harvested_weight"/>
                        <field name="broiler_harvest_avg_weight"/>
                        <field name="broiler_feed_qty"/>
                        <field name="broiler_fcr"/>
                    </group>
                    <group groups="top_farm_core.group_farm_manager">
                        <field name="broiler_released_cost"/>
                        <field name="broiler_sale_amount"/>
                        <field name="broiler_gross_margin"
                               decoration-danger="broiler_gross_margin &lt; 0"
                               decoration-success="broiler_gross_margin &gt; 0"/>
                        <field name="broiler_margin_pct"/>
                    </group>
                </group>
            </xpath>
            <!-- Layer flock: hens culled into Layer Live Weight -->
            <xpath expr="//group[@name='broiler_harvest_group']" position="after">
                <group name="layer_cull_group" string="Culled Hens - Live Weight Harvests"
                       invisible="not is_flock_batch or flock_type != 'layer' or not broiler_harvest_count"
                       groups="top_farm_core.group_farm_user">
                    <group>
                        <field name="broiler_harvested_birds" string="Hens Culled"/>
                        <field name="broiler_harvested_weight" string="Live Weight Produced (kg)"/>
                        <field name="broiler_harvest_avg_weight" string="Avg Culling Weight (kg)"/>
                    </group>
                    <group groups="top_farm_core.group_farm_manager">
                        <field name="broiler_released_cost" string="Hen Stock Value Converted"/>
                    </group>
                </group>
            </xpath>
            <!-- Egg and meat lots: their parent flock and production day -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="farm_flock_lot_id" invisible="not farm_flock_lot_id"/>
                <field name="farm_production_date" invisible="not farm_production_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_farm_flock_lot_list_operations" model="ir.ui.view">
        <field name="name">stock.lot.list.top_farm.flock.operations</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="top_farm_core.view_farm_flock_lot_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='live_bird_count']" position="after">
                <field name="rolling_hen_day_pct" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
