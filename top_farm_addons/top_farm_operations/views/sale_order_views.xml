<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_top_farm_broiler" model="ir.ui.view">
        <field name="name">sale.order.form.top_farm.broiler</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="farm_broiler_lot_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
