<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_farm_feed_log_company" model="ir.rule">
        <field name="name">Farm Feed Log: multi-company</field>
        <field name="model_id" ref="model_farm_feed_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_farm_feed_log_line_company" model="ir.rule">
        <field name="name">Farm Feed Log Line: multi-company</field>
        <field name="model_id" ref="model_farm_feed_log_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_farm_egg_collection_company" model="ir.rule">
        <field name="name">Farm Egg Collection: multi-company</field>
        <field name="model_id" ref="model_farm_egg_collection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
