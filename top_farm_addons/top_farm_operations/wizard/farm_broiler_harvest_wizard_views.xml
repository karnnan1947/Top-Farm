<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_broiler_harvest_wizard_form" model="ir.ui.view">
        <field name="name">farm.broiler.harvest.wizard.form</field>
        <field name="model">farm.broiler.harvest.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Broiler Harvest &amp; Meat Conversion">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="shed_location_ids" invisible="1"/>
                <group>
                    <group string="Harvest / Bird Pickup">
                        <field name="flock_lot_id"/>
                        <field name="location_id" options="{'no_create': True}"/>
                        <field name="available_birds"/>
                        <field name="birds_count"/>
                        <field name="average_weight"/>
                        <field name="total_weight_kg"/>
                        <field name="net_average_weight"/>
                    </group>
                    <group string="Meat Production &amp; Valuation">
                        <field name="harvest_cost"/>
                        <field name="cost_per_kg"/>
                        <field name="remaining_birds"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" invisible="remaining_birds or not birds_count">
                    These are the last birds of the batch: it is closed once the harvest is recorded.
                </div>
                <p class="text-muted">A conversion manufacturing order converts the harvested birds (units) into broiler meat (kg) in stock, carrying the accumulated batch cost. Sales orders are created separately from the Sales module.</p>
                <footer>
                    <button name="action_confirm_harvest" string="Confirm Harvest &amp; Produce Meat" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
