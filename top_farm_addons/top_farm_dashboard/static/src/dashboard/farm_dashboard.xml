<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- ============================== LAYER ============================== -->
    <t t-name="top_farm_dashboard.LayerDashboard">
        <div class="o_farm_dashboard o_farm_layer_dashboard p-3 overflow-auto h-100">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <h3 class="m-0 me-auto">Layer Performance Dashboard</h3>
                <label class="d-flex align-items-center gap-1">From
                    <input type="date" class="form-control form-control-sm" t-model="this.from" t-on-change="this.onFilterChange"/></label>
                <label class="d-flex align-items-center gap-1">To
                    <input type="date" class="form-control form-control-sm" t-model="this.to" t-on-change="this.onFilterChange"/></label>
                <select class="form-select form-select-sm w-auto o_farm_flock_filter" t-model="this.flock" t-on-change="this.onFilterChange">
                    <option value="">All active layer flocks</option>
                    <t t-foreach="this.state.data.flocks" t-as="f" t-key="f.id">
                        <option t-att-value="f.id" t-esc="f.name"/>
                    </t>
                </select>
                <select class="form-select form-select-sm w-auto" t-model="this.days" t-on-change="this.onFilterChange">
                    <option value="7">Trend: 7 days</option>
                    <option value="14">Trend: 14 days</option>
                    <option value="30">Trend: 30 days</option>
                </select>
                <button class="btn btn-sm btn-secondary" t-on-click="() => this.openDailyReport()">
                    Daily Report
                </button>
            </div>
            <t t-set="d" t-value="this.state.data"/>
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6 col-xl-4 col-xxl-2">
                    <div class="o_farm_card" t-on-click="() => this.openPopulation()" role="button">
                        <div class="o_farm_card_title">Live Hens</div>
                        <div class="o_farm_card_value" t-esc="this.fmt(d.live_population)"/>
                        <div class="o_farm_card_sub" t-esc="d.population_detail"/>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-4 col-xxl-2">
                    <div t-attf-class="o_farm_card o_farm_card_hen_day {{ this.statusClass(d.hen_day_ok) }}" t-on-click="() => this.openDailyReport()" role="button">
                        <div class="o_farm_card_title">Hen-Day Production</div>
                        <div class="o_farm_card_value"><t t-esc="d.hen_day"/>%</div>
                        <div class="o_farm_card_sub">target at least <t t-esc="d.target_hen_day"/>% · <t t-esc="this.fmt(d.eggs)"/> eggs / <t t-esc="this.fmt(d.bird_days)"/> hen-days</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-4 col-xxl-2">
                    <div class="o_farm_card o_farm_card_hen_housed" t-on-click="() => this.openDailyReport()" role="button">
                        <div class="o_farm_card_title">Hen-Housed Production</div>
                        <div class="o_farm_card_value"><t t-esc="d.hen_housed"/>%</div>
                        <div class="o_farm_card_sub">eggs per hen housed at point of lay · <t t-esc="this.fmt(d.housed_birds)"/> hens housed</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-4 col-xxl-2">
                    <div class="o_farm_card o_farm_card_feed_hen" t-on-click="() => this.openCollections()" role="button">
                        <div class="o_farm_card_title">Feed / Hen / Day</div>
                        <div class="o_farm_card_value"><t t-esc="this.fmt(d.feed_per_hen_g, 1)"/> <small>g</small></div>
                        <div class="o_farm_card_sub"><t t-esc="this.fmt(d.feed_kg, 1)"/> kg laying feed / <t t-esc="this.fmt(d.fed_bird_days)"/> hen-days</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-4 col-xxl-2">
                    <div t-attf-class="o_farm_card o_farm_card_fcr {{ this.statusClass(d.fcr_ok) }}" t-on-click="() => this.openCollections()" role="button">
                        <div class="o_farm_card_title">Feed per Dozen</div>
                        <div class="o_farm_card_value"><t t-esc="d.fcr"/> <small>kg/dozen</small></div>
                        <div class="o_farm_card_sub">target at most <t t-esc="d.target_fcr"/></div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-4 col-xxl-2">
                    <div t-attf-class="o_farm_card o_farm_card_mortality {{ this.statusClass(d.mortality_ok) }}" t-on-click="() => this.openMortality()" role="button">
                        <div class="o_farm_card_title">Mortality</div>
                        <div class="o_farm_card_value"><t t-esc="d.mortality"/>%</div>
                        <div class="o_farm_card_sub">
                            <t t-if="d.multi_day">avg daily · </t><t t-esc="d.dead"/> dead / <t t-esc="this.fmt(d.mortality_base)"/> opening hens
                            · cumulative <t t-esc="d.cumulative_mortality"/>% since placement
                            <t t-if="d.pending_approval"> · <b t-esc="d.pending_approval"/> waiting approval</t>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-xl-8">
                    <div class="o_farm_panel">
                        <div class="o_farm_card_title">Daily Egg Harvest by Grade &amp; Hen-Day %</div>
                        <div class="o_farm_chart"><canvas t-ref="this.trend.ref"/></div>
                    </div>
                </div>
                <div class="col-12 col-xl-4">
                    <div class="o_farm_panel">
                        <div class="o_farm_card_title">Egg Grading Mix (selected period)</div>
                        <div class="o_farm_chart"><canvas t-ref="this.mix.ref"/></div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ============================== BROILER ============================== -->
    <t t-name="top_farm_dashboard.BroilerDashboard">
        <div class="o_farm_dashboard o_farm_broiler_dashboard p-3 overflow-auto h-100">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <h3 class="m-0 me-auto">Broiler Performance Dashboard</h3>
                <label class="d-flex align-items-center gap-1" title="Period of the daily feed intake chart and card">From
                    <input type="date" class="form-control form-control-sm" t-model="this.from" t-on-change="this.onFilterChange"/></label>
                <label class="d-flex align-items-center gap-1">To
                    <input type="date" class="form-control form-control-sm" t-model="this.to" t-on-change="this.onFilterChange"/></label>
                <select class="form-select form-select-sm w-auto o_farm_flock_filter" t-model="this.flock" t-on-change="this.onFilterChange">
                    <option value="">All live broiler batches</option>
                    <t t-foreach="this.state.data.batches" t-as="b" t-key="b.id">
                        <option t-att-value="b.id" t-esc="b.name"/>
                    </t>
                </select>
            </div>
            <t t-set="d" t-value="this.state.data"/>
            <div t-if="!d.rows.length" class="alert alert-info">No live broiler batch. Choose a closed batch in the filter to review it.</div>
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6 col-xl">
                    <div class="o_farm_card" t-on-click="() => this.openLiveBirds()" role="button">
                        <div class="o_farm_card_title">Live Broilers</div>
                        <div class="o_farm_card_value" t-esc="this.fmt(d.live)"/>
                        <div class="o_farm_card_sub">
                            <t t-if="d.rows.length === 1">day <t t-esc="d.rows[0].age"/> · <t t-esc="d.rows[0].stage"/> · </t>
                            <t t-else=""><t t-esc="d.batch_count"/> batches · </t>
                            <t t-esc="this.fmt(d.placed)"/> chicks placed
                            <t t-if="d.harvested_birds"> · <t t-esc="this.fmt(d.harvested_birds)"/> harvested</t>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div class="o_farm_card o_farm_card_biomass" t-on-click="() => this.openBatches()" role="button">
                        <div class="o_farm_card_title">Live Biomass</div>
                        <div class="o_farm_card_value"><t t-esc="this.fmt(d.biomass)"/> <small>kg</small></div>
                        <div class="o_farm_card_sub">live broilers x estimated avg weight
                            <t t-if="d.abw">(<t t-esc="this.fmt(d.abw, 3)"/> kg)</t>
                            <t t-if="d.harvested_kg"> · <t t-esc="this.fmt(d.harvested_kg)"/> kg harvested</t></div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div t-attf-class="o_farm_card o_farm_card_fcr {{ this.statusClass(d.fcr_ok) }}" t-on-click="() => this.openFeedLogs()" role="button">
                        <div class="o_farm_card_title">Feed Conversion Ratio</div>
                        <div class="o_farm_card_value"><t t-esc="this.fmt(d.fcr, 3)"/> <small>kg/kg</small></div>
                        <div class="o_farm_card_sub">target at most <t t-esc="d.target_fcr"/> · <t t-esc="this.fmt(d.feed_kg)"/> kg feed / <t t-esc="this.fmt(d.biomass + d.harvested_kg)"/> kg live weight</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div t-attf-class="o_farm_card o_farm_card_mortality {{ this.statusClass(d.mortality_ok) }}" t-on-click="() => this.openMortality()" role="button">
                        <div class="o_farm_card_title">Cumulative Mortality</div>
                        <div class="o_farm_card_value"><t t-esc="d.mortality"/>%</div>
                        <div class="o_farm_card_sub"><t t-esc="this.fmt(d.dead)"/> dead / <t t-esc="this.fmt(d.placed)"/> placed · alert above <t t-esc="d.mortality_alert"/>%</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div class="o_farm_card o_farm_card_intake" t-on-click="() => this.openFeedLogs()" role="button">
                        <div class="o_farm_card_title">Daily Feed Intake</div>
                        <div class="o_farm_card_value"><t t-esc="this.fmt(d.intake_g, 1)"/> <small>g/bird/day</small></div>
                        <div class="o_farm_card_sub">average of the period · <t t-esc="this.fmt(d.period_feed_kg)"/> kg fed</div>
                    </div>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <div class="o_farm_panel">
                        <div class="o_farm_card_title">Daily Feed Intake (Booster → Starter → Finisher)</div>
                        <div class="o_farm_chart"><canvas t-ref="this.feed.ref"/></div>
                    </div>
                </div>
            </div>
            <div class="o_farm_panel o_farm_batch_panel" t-if="d.rows.length">
                <div class="o_farm_card_title mb-2">Broiler Batches</div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 o_farm_batch_table">
                        <thead>
                            <tr>
                                <th>Batch</th><th>Stage</th><th class="text-end">Age (d)</th>
                                <th class="text-end">Placed</th><th class="text-end">Live</th>
                                <th class="text-end">Mortality</th><th class="text-end">Avg Weight (kg)</th>
                                <th class="text-end">Biomass (kg)</th><th class="text-end">Harvested (kg)</th>
                                <th class="text-end">Feed (kg)</th><th class="text-end">FCR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="d.rows" t-as="r" t-key="r.id">
                                <tr role="button" t-on-click="() => this.openBatch(r.id)">
                                    <td t-esc="r.name"/>
                                    <td t-esc="r.stage"/>
                                    <td class="text-end" t-esc="r.age"/>
                                    <td class="text-end" t-esc="this.fmt(r.placed)"/>
                                    <td class="text-end" t-esc="this.fmt(r.live)"/>
                                    <td class="text-end"><t t-esc="r.mortality"/>%</td>
                                    <td class="text-end" t-esc="this.fmt(r.abw, 3)"/>
                                    <td class="text-end" t-esc="this.fmt(r.biomass)"/>
                                    <td class="text-end" t-esc="this.fmt(r.harvested_kg)"/>
                                    <td class="text-end" t-esc="this.fmt(r.feed_kg)"/>
                                    <td class="text-end" t-esc="this.fmt(r.fcr, 3)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
