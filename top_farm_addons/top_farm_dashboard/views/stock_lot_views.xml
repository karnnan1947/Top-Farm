<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_farm_dashboard" model="ir.ui.view">
        <field name="name">stock.lot.form.farm.dashboard</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="farm_batch_location_id" invisible="not farm_batch_location_id"/>
                <field name="farm_production_date" invisible="not farm_production_date"/>
            </xpath>
        </field>
    </record>
</odoo>
