<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_egg_daily_report_list" model="ir.ui.view">
        <field name="name">farm.egg.daily.report.list</field>
        <field name="model">farm.egg.daily.report</field>
        <field name="arch" type="xml">
            <list string="Daily Egg Production" create="false" edit="false" delete="false"
                  default_order="date desc, flock_lot_id, cage_location_id">
                <field name="date"/>
                <field name="farm_location_id"/>
                <field name="flock_lot_id"/>
                <field name="cage_location_id"/>
                <field name="flock_age_weeks" optional="hide"/>
                <field name="flock_stage" optional="hide"/>
                <field name="destination_location_id" optional="hide"/>
                <field name="live_bird_count" sum="Live Birds"/>
                <field name="total_eggs" sum="Total Eggs"/>
                <field name="hen_day_pct"/>
                <field name="eggs_large" sum="Large"/>
                <field name="eggs_medium" sum="Medium"/>
                <field name="eggs_jumbo" sum="Jumbo"/>
                <field name="eggs_damage" sum="Damaged / Cracked"/>
                <field name="damaged_pct" optional="hide"/>
                <field name="dozens" optional="hide" sum="Dozens"/>
                <field name="feed_kg" sum="Feed (kg)"/>
                <field name="fed_bird_count" column_invisible="1"/>
                <field name="fed_dozens" column_invisible="1"/>
                <field name="feed_per_bird_g" optional="hide"/>
                <field name="fcr"/>
            </list>
        </field>
    </record>
    <record id="view_farm_egg_daily_report_pivot" model="ir.ui.view">
        <field name="name">farm.egg.daily.report.pivot</field>
        <field name="model">farm.egg.daily.report</field>
        <field name="arch" type="xml">
            <pivot string="Daily Egg Production" disable_linking="0">
                <field name="date" interval="day" type="row"/>
                <field name="flock_lot_id" type="row"/>
                <field name="live_bird_count" type="measure"/>
                <field name="total_eggs" type="measure"/>
                <field name="hen_day_pct" type="measure"/>
                <field name="feed_kg" type="measure"/>
                <field name="fcr" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_farm_egg_daily_report_graph" model="ir.ui.view">
        <field name="name">farm.egg.daily.report.graph</field>
        <field name="model">farm.egg.daily.report</field>
        <field name="arch" type="xml">
            <graph string="Hen-Day % by Day" type="line" stacked="0">
                <field name="date" interval="day"/>
                <field name="flock_lot_id"/>
                <field name="hen_day_pct" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_farm_egg_daily_report_search" model="ir.ui.view">
        <field name="name">farm.egg.daily.report.search</field>
        <field name="model">farm.egg.daily.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="flock_lot_id"/>
                <field name="farm_location_id"/>
                <field name="cage_location_id"/>
                <field name="destination_location_id"/>
                <filter name="filter_date" string="Date" date="date"/>
                <filter name="filter_last_7" string="Last 7 Days"
                        domain="[('date', '>=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_last_30" string="Last 30 Days"
                        domain="[('date', '>=', (context_today() - relativedelta(days=29)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_laying" string="Laying Flocks" domain="[('flock_stage', '=', 'laying')]"/>
                <filter name="filter_rearing" string="Pre-Laying Flocks" domain="[('flock_stage', '=', 'rearing')]"/>
                <separator/>
                <filter name="filter_fed" string="With Laying Feed" domain="[('feed_kg', '>', 0)]"/>
                <group>
                    <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="group_week" string="Week" context="{'group_by': 'date:week'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_farm" string="Farm Estate" context="{'group_by': 'farm_location_id'}"/>
                    <filter name="group_flock" string="Flock Batch" context="{'group_by': 'flock_lot_id'}"/>
                    <filter name="group_cage" string="Cage" context="{'group_by': 'cage_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_farm_egg_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Egg Production &amp; Hen-Day %</field>
        <field name="res_model">farm.egg.daily.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_farm_egg_daily_report_search"/>
        <field name="context">{'search_default_group_day': 1, 'search_default_group_flock': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No egg collection produced yet</p>
            <p>One row per cage and day: the live birds of the cage when the eggs were collected, the eggs of each
               grade, the Hen-Day % (eggs / live birds x 100), the laying feed and the FCR (kg feed per dozen eggs).
               Grouped by day and flock, the subtotals divide the eggs by the birds of their rows, so the Hen-Day %
               of a flock-day is exact. The pivot view's Download xlsx button exports these subtotals.</p>
        </field>
    </record>
</odoo>
