<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Layer flocks (eggs) and broiler batches (meat) have their own KPI dashboard -->
    <record id="action_farm_dashboard_layer" model="ir.actions.client">
        <field name="name">Layer Performance Dashboard</field>
        <field name="tag">top_farm_dashboard.layer_dashboard</field>
    </record>
    <record id="action_farm_dashboard_broiler" model="ir.actions.client">
        <field name="name">Broiler Performance Dashboard</field>
        <field name="tag">top_farm_dashboard.broiler_dashboard</field>
    </record>
    <!-- Former mixed Flock Performance Dashboard: links and bookmarks to it now open the layer dashboard -->
    <record id="action_farm_dashboard_kpis" model="ir.actions.client">
        <field name="name">Layer Performance Dashboard</field>
        <field name="tag">top_farm_dashboard.layer_dashboard</field>
    </record>
</odoo>
