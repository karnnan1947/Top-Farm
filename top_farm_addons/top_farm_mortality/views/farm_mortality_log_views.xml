<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_mortality_log_form" model="ir.ui.view">
        <field name="name">farm.mortality.log.form</field>
        <field name="model">farm.mortality.log</field>
        <field name="arch" type="xml">
            <form string="Poultry Mortality Record">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_manager_approve" string="Approve Scrap" type="object"
                            class="btn-success" invisible="state != 'waiting_approval' or not is_manager"/>
                    <button name="action_open_reject" string="Reject" type="object" class="btn-danger"
                            invisible="state != 'waiting_approval' or not is_manager"/>
                    <button name="action_open_reverse" string="Reverse" type="object"
                            invisible="state != 'done' or not is_manager"
                            confirm="Birds will be returned to the cage. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_approval,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scrap" type="object" class="oe_stat_button"
                                icon="fa-trash" invisible="not scrap_id">
                            <div class="o_stat_info"><span class="o_stat_text">Stock Scrap</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="is_manager" invisible="1"/>
                    <field name="can_backdate" invisible="1"/>
                    <field name="is_backdated" invisible="1"/>
                    <field name="product_tracking" invisible="1"/>
                    <group>
                        <group string="Flock &amp; Cage">
                            <field name="date" readonly="state != 'draft' or not can_backdate"/>
                            <field name="backdate_reason" invisible="not is_backdated"
                                   required="is_backdated" readonly="state != 'draft'"/>
                            <field name="cage_location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="batch_location_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group string="Loss Details">
                            <field name="bird_product_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="lot_id" readonly="state != 'draft'" options="{'no_create': True}"
                                   required="product_tracking == 'lot'" invisible="product_tracking == 'none'"/>
                            <field name="dead_bird_count" readonly="state != 'draft'"/>
                            <field name="cause_of_death" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Threshold Check">
                        <group>
                            <field name="opening_population" force_save="1"/>
                            <field name="cumulative_dead" force_save="1"/>
                        </group>
                        <group>
                            <field name="mortality_pct" force_save="1" decoration-danger="requires_approval"
                                   decoration-success="not requires_approval"/>
                            <field name="threshold_pct_used" force_save="1"/>
                            <field name="requires_approval" force_save="1"/>
                        </group>
                    </group>
                    <group invisible="state not in ('done', 'rejected', 'reversed')" string="Decision">
                        <field name="approved_by_id" invisible="not approved_by_id"/>
                        <field name="approved_date" invisible="not approved_date"/>
                        <field name="rejection_reason" invisible="not rejection_reason"/>
                        <field name="reversal_reason" invisible="not reversal_reason"/>
                        <field name="reversal_move_id" invisible="not reversal_move_id"/>
                    </group>
                    <group string="Observations">
                        <field name="notes" nolabel="1" readonly="state != 'draft'"
                               placeholder="Symptoms, temperature, water supply..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_farm_mortality_log_list" model="ir.ui.view">
        <field name="name">farm.mortality.log.list</field>
        <field name="model">farm.mortality.log</field>
        <field name="arch" type="xml">
            <list string="Mortality Records" decoration-warning="state == 'waiting_approval'"
                  decoration-muted="state in ('rejected', 'reversed')">
                <field name="name"/>
                <field name="date"/>
                <field name="batch_location_id"/>
                <field name="cage_location_id"/>
                <field name="dead_bird_count" sum="Total Dead"/>
                <field name="mortality_pct"/>
                <field name="cause_of_death"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'waiting_approval'"
                       decoration-success="state == 'done'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_farm_mortality_log_search" model="ir.ui.view">
        <field name="name">farm.mortality.log.search</field>
        <field name="model">farm.mortality.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cage_location_id"/>
                <field name="batch_location_id"/>
                <filter name="waiting" string="Waiting Approval" domain="[('state', '=', 'waiting_approval')]"/>
                <filter name="done" string="Scrapped" domain="[('state', '=', 'done')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_location_id'}"/>
                    <filter name="group_cage" string="Cage" context="{'group_by': 'cage_location_id'}"/>
                    <filter name="group_cause" string="Cause" context="{'group_by': 'cause_of_death'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_farm_mortality_log_pivot" model="ir.ui.view">
        <field name="name">farm.mortality.log.pivot</field>
        <field name="model">farm.mortality.log</field>
        <field name="arch" type="xml">
            <pivot string="Mortality Analysis">
                <field name="batch_location_id" type="row"/>
                <field name="cage_location_id" type="row"/>
                <field name="cause_of_death" type="col"/>
                <field name="dead_bird_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_farm_mortality_log_graph" model="ir.ui.view">
        <field name="name">farm.mortality.log.graph</field>
        <field name="model">farm.mortality.log</field>
        <field name="arch" type="xml">
            <graph string="Mortality by Cause" type="bar">
                <field name="date" interval="day"/>
                <field name="cause_of_death"/>
                <field name="dead_bird_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_farm_mortality_log" model="ir.actions.act_window">
        <field name="name">Mortality Records</field>
        <field name="res_model">farm.mortality.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_farm_mortality_log_search"/>
    </record>

    <record id="action_farm_mortality_analysis" model="ir.actions.act_window">
        <field name="name">Mortality Analysis</field>
        <field name="res_model">farm.mortality.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="search_view_id" ref="view_farm_mortality_log_search"/>
    </record>
</odoo>
